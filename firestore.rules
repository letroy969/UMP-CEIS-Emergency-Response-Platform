rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function campusEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@ump[.]ac[.]za$');
    }

    function verified() {
      return campusEmail() && request.auth.token.email_verified == true;
    }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function profileRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function admin() {
      return verified() && profileExists(request.auth.uid) && profileRole(request.auth.uid) == 'admin';
    }

    function responder() {
      return verified()
        && profileExists(request.auth.uid)
        && profileRole(request.auth.uid) in ['responder', 'security', 'medical'];
    }

    function validCoordinates(data) {
      return (data.latitude == null && data.longitude == null)
        || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number && data.longitude >= -180 && data.longitude <= 180);
    }

    function validResponder(uid) {
      return uid == null
        || (uid is string
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.role
            in ['responder', 'security', 'medical']);
    }

    match /users/{userId} {
      allow create: if campusEmail()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'fullName', 'role', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt == request.time;

      allow read: if (signedIn() && request.auth.uid == userId) || admin();

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'faculty', 'year', 'department']);

      allow delete: if false;
    }

    match /incidents/{incidentId} {
      allow read: if verified()
        && (admin()
          || resource.data.reportedBy == request.auth.uid
          || (responder() && resource.data.responderUid == request.auth.uid));

      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'reference', 'reportedBy', 'responderUid', 'dispatchedByUid',
          'type', 'priority', 'building', 'description', 'status', 'responder',
          'latitude', 'longitude', 'accuracyMeters', 'locationCapturedAt',
          'locationSource', 'campusVerified', 'reporterName', 'createdAt',
          'updatedAt', 'dispatchedAt', 'resolvedAt'
        ])
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.responderUid == null
        && request.resource.data.dispatchedByUid == null
        && request.resource.data.reference is string
        && request.resource.data.type in [
          'medical', 'fire', 'security', 'hazard', 'infrastructure', 'wellbeing', 'other'
        ]
        && request.resource.data.priority in ['P1', 'P2', 'P3', 'P4']
        && request.resource.data.building is string
        && request.resource.data.building.matches('^[0-9]{1,3}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 4000
        && request.resource.data.status == 'NEW'
        && request.resource.data.responder == null
        && validCoordinates(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'responder', 'responderUid', 'dispatchedByUid',
            'updatedAt', 'dispatchedAt', 'resolvedAt'
          ])
        && request.resource.data.status in [
          'NEW', 'ACKNOWLEDGED', 'TEAM_DISPATCHED', 'ON_SCENE', 'RESOLVED', 'CLOSED'
        ]
        && validResponder(request.resource.data.responderUid)
        && (request.resource.data.status != 'TEAM_DISPATCHED'
          || (request.resource.data.responderUid is string
            && request.resource.data.dispatchedByUid == request.auth.uid))
        && request.resource.data.updatedAt == request.time;

      allow update: if responder()
        && resource.data.responderUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'resolvedAt'])
        && ((request.resource.data.status == 'ACKNOWLEDGED'
            && resource.data.status == 'TEAM_DISPATCHED')
          || (request.resource.data.status == 'ON_SCENE'
            && resource.data.status == 'ACKNOWLEDGED')
          || (request.resource.data.status == 'RESOLVED'
            && resource.data.status == 'ON_SCENE'
            && request.resource.data.resolvedAt == request.time))
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /safetyCheckins/{checkinId} {
      allow read: if verified()
        && (resource.data.userId == request.auth.uid || admin());

      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'userId', 'status', 'note', 'latitude', 'longitude', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['safe', 'help']
        && (request.resource.data.note == null
          || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && validCoordinates(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
