rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function hasRole(profile, expectedRole) {
      return ('role' in profile
          && (profile.role == expectedRole
            || (profile.role is list && expectedRole in profile.role)))
        || ('roles' in profile
          && profile.roles is list
          && expectedRole in profile.roles);
    }

    function hasAnyRole(profile, expectedRoles) {
      return ('role' in profile
          && ((profile.role is string && profile.role in expectedRoles)
            || (profile.role is list && profile.role.hasAny(expectedRoles))))
        || ('roles' in profile
          && profile.roles is list
          && profile.roles.hasAny(expectedRoles));
    }

    function profileHasRole(uid, expectedRole) {
      return profileExists(uid)
        && hasRole(get(/databases/$(database)/documents/users/$(uid)).data, expectedRole);
    }

    function admin() {
      return verified() && profileHasRole(request.auth.uid, 'admin');
    }

    function responder() {
      return verified()
        && profileExists(request.auth.uid)
        && hasAnyRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, ['responder', 'security', 'medical']);
    }

    function validCoordinates(data) {
      return (data.latitude == null && data.longitude == null)
        || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number && data.longitude >= -180 && data.longitude <= 180);
    }

    function validResponder(uid) {
      return uid == null
        || (uid is string
          && exists(/databases/$(database)/documents/users/$(uid))
          && hasAnyRole(get(/databases/$(database)/documents/users/$(uid)).data, ['responder', 'security', 'medical']));
    }

    function validStudentEmail(email) {
      return email is string
        && email.size() == 19
        && email.matches('^[0-9]{9}@ump[.]ac[.]za$');
    }

    function validUmpRoleEmail(email) {
      return email is string
        && email.size() <= 254
        && email.matches('^[^@]+@ump[.]ac[.]za$');
    }

    match /users/{userId} {
      allow create: if verified()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'fullName', 'role', 'createdAt',
          'requestedRole', 'roleRequestStatus', 'roleRequestedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.role == 'student'
            && validStudentEmail(request.resource.data.email)
            && !('requestedRole' in request.resource.data)
            && !('roleRequestStatus' in request.resource.data)
            && !('roleRequestedAt' in request.resource.data))
          || (request.resource.data.role == 'staff'
            && validUmpRoleEmail(request.resource.data.email)
            && !('requestedRole' in request.resource.data)
            && !('roleRequestStatus' in request.resource.data)
            && !('roleRequestedAt' in request.resource.data))
          || (request.resource.data.role == 'student'
            && validUmpRoleEmail(request.resource.data.email)
            && request.resource.data.requestedRole in ['responder', 'admin']
            && request.resource.data.roleRequestStatus == 'pending'
            && request.resource.data.roleRequestedAt == request.time));

      allow read: if (verified() && request.auth.uid == userId) || admin();

      allow update: if verified()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'faculty', 'year', 'department'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && (!('faculty' in request.resource.data)
          || (request.resource.data.faculty is string && request.resource.data.faculty.size() <= 100))
        && (!('department' in request.resource.data)
          || (request.resource.data.department is string && request.resource.data.department.size() <= 100))
        && (!('year' in request.resource.data)
          || (request.resource.data.year is int && request.resource.data.year >= 1 && request.resource.data.year <= 8));

      allow delete: if false;

      match /emergencyContacts/{contactId} {
        function validContact(data) {
          return data.keys().hasAll([
              'uid', 'name', 'relationship', 'phone', 'order', 'createdAt', 'updatedAt'
            ])
            && data.keys().hasOnly([
              'uid', 'name', 'relationship', 'phone', 'order', 'createdAt', 'updatedAt'
            ])
            && data.uid == userId
            && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
            && data.name.matches('.*[^ ].*')
            && data.relationship is string && data.relationship.size() >= 2 && data.relationship.size() <= 50
            && data.relationship.matches('.*[^ ].*')
            && data.phone is string && data.phone.matches('^[+][1-9][0-9]{7,14}$')
            && data.order is int && data.order >= 0 && data.order <= 9;
        }

        allow read: if verified() && request.auth.uid == userId;
        allow create: if verified()
          && request.auth.uid == userId
          && validContact(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if verified()
          && request.auth.uid == userId
          && validContact(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if verified() && request.auth.uid == userId;
      }

      match /private/{privateDocument} {
        allow read: if verified()
          && request.auth.uid == userId
          && privateDocument == 'preferences';
        allow create, update: if verified()
          && request.auth.uid == userId
          && privateDocument == 'preferences'
          && request.resource.data.keys().hasAll(['reducedMotion', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['reducedMotion', 'updatedAt'])
          && request.resource.data.reducedMotion is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if verified()
          && request.auth.uid == userId
          && privateDocument == 'preferences';
      }
    }

    match /incidents/{incidentId} {
      allow read: if verified()
        && (admin()
          || resource.data.reportedBy == request.auth.uid
          || (responder() && resource.data.responderUid == request.auth.uid));

      // Incident writes go through the authenticated Express API so that
      // dispatch, state transitions, notification hooks, and audit events stay atomic.
      allow create, update: if false;

      match /events/{eventId} {
        allow read: if verified()
          && (admin()
            || get(/databases/$(database)/documents/incidents/$(incidentId)).data.reportedBy == request.auth.uid
            || (responder()
              && get(/databases/$(database)/documents/incidents/$(incidentId)).data.responderUid == request.auth.uid));
        allow write: if false;
      }

      allow delete: if false;
    }

    match /safetyCheckins/{checkinId} {
      allow read: if verified()
        && (resource.data.userId == request.auth.uid || admin());

      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'userId', 'status', 'note', 'latitude', 'longitude', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['safe', 'help']
        && (request.resource.data.note == null
          || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && validCoordinates(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
