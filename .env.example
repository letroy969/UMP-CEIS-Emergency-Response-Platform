# Firebase web app configuration. Copy these values from the Firebase Console.
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_web_push_certificate_key
VITE_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_v3_site_key

# Server-only Firebase Admin credentials. Never use a VITE_ prefix.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Replace the entire value with the complete one-line JSON from your service account file.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"replace_with_private_key_id","private_key":"-----BEGIN PRIVATE KEY-----\nreplace_with_complete_private_key\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","client_id":"replace_with_client_id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40example.iam.gserviceaccount.com","universe_domain":"googleapis.com"}
FIREBASE_APP_CHECK_APP_ID=your_firebase_web_app_id
SOS_RATE_LIMIT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Optional local alternative: use a service-account JSON file path or Google ADC.
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\path\firebase-admin.json
CRON_SECRET=replace_with_a_long_random_secret
APP_URL=https://ump-ceis-emergency-response-platfor.vercel.app
SOS_MAX_DISPATCH_KM=15
GROQ_API_KEY=
# Optional Groq model override. The default is openai/gpt-oss-120b.
GROQ_MODEL=

# Private Cloudflare R2 evidence bucket. Keep all values server-only.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=ump-ceis-evidence
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional emergency alert channels. SMS is sent only to provisioned users
# whose phoneE164 and smsOptIn profile fields are set by a trusted admin.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PA_WEBHOOK_URL=
PA_WEBHOOK_SECRET=
